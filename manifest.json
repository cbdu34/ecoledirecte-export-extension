{
  "manifest_version": 3,
  "name": "Export EcoleDirecte pour l'IA",
  "version": "1.0.0",
  "description": "Exportez vos notes, devoirs, messages et espaces de travail EcoleDirecte dans un seul fichier JSON prêt pour l'IA.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.ecoledirecte.com/*",
    "https://ecoledirecte.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Exporter mes données EcoleDirecte",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ecoledirecte.com/*",
        "https://ecoledirecte.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
